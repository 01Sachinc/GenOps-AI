pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'staging', 'prod'], description: 'Environment to deploy to')
        booleanParam(name: 'RUN_SECURITY_SCAN', defaultValue: true, description: 'Run Trivy security scan')
    }

    environment {
        DOCKER_HUB_USER = "01sachinc"
        APP_NAME = "genops-ai"
        BACKEND_IMAGE = "${DOCKER_HUB_USER}/${APP_NAME}-backend"
        FRONTEND_IMAGE = "${DOCKER_HUB_USER}/${APP_NAME}-frontend"
        K8S_NAMESPACE = "genops-${params.DEPLOY_ENV}"
        SCAN_IMAGE = true
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    echo "Starting build for ${APP_NAME} in ${params.DEPLOY_ENV} environment"
                    currentBuild.displayName = "#${BUILD_NUMBER}-${params.DEPLOY_ENV}"
                }
            }
        }

        stage('Build & Test') {
            parallel {
                stage('Backend Build') {
                    steps {
                        dir('backend') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
                stage('Frontend Build') {
                    steps {
                        dir('frontend') {
                            sh 'npm install'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Static Analysis') {
            parallel {
                stage('SonarQube Backend') {
                    steps {
                        echo 'Running SonarQube Backend analysis...'
                        // sh 'mvn sonar:sonar'
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        dir('frontend') {
                            sh 'npm run lint || true'
                        }
                    }
                }
            }
        }

        stage('Docker Build & Scan') {
            steps {
                script {
                    docker.withRegistry('', 'docker-hub-credentials') {
                        // Build Backend
                        def backend = docker.build("${BACKEND_IMAGE}:${BUILD_NUMBER}", "./backend")
                        
                        if (params.RUN_SECURITY_SCAN) {
                            echo "Scanning Backend Image: ${BACKEND_IMAGE}:${BUILD_NUMBER}"
                            // sh "trivy image ${BACKEND_IMAGE}:${BUILD_NUMBER}"
                        }
                        
                        backend.push()
                        backend.push('latest')

                        // Build Frontend
                        def frontend = docker.build("${FRONTEND_IMAGE}:${BUILD_NUMBER}", "./frontend")
                        
                        if (params.RUN_SECURITY_SCAN) {
                            echo "Scanning Frontend Image: ${FRONTEND_IMAGE}:${BUILD_NUMBER}"
                            // sh "trivy image ${FRONTEND_IMAGE}:${BUILD_NUMBER}"
                        }
                        
                        frontend.push()
                        frontend.push('latest')
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                script {
                    dir('k8s') {
                        echo "Deploying to Kubernetes Namespace: ${K8S_NAMESPACE}"
                        sh "kubectl apply -f namespace.yaml --namespace=${K8S_NAMESPACE} || kubectl create namespace ${K8S_NAMESPACE}"
                        
                        // Use envsubst or similar for dynamic image tagging in production pipelines
                        sh "sed -i 's|image: .*-backend:.*|image: ${BACKEND_IMAGE}:${BUILD_NUMBER}|g' backend/deployment.yaml"
                        sh "sed -i 's|image: .*-frontend:.*|image: ${FRONTEND_IMAGE}:${BUILD_NUMBER}|g' frontend/deployment.yaml"
                        
                        sh "kubectl apply -f config/ --namespace=${K8S_NAMESPACE}"
                        sh "kubectl apply -f postgres/ --namespace=${K8S_NAMESPACE}"
                        sh "kubectl apply -f redis/ --namespace=${K8S_NAMESPACE}"
                        sh "kubectl apply -f backend/ --namespace=${K8S_NAMESPACE}"
                        sh "kubectl apply -f frontend/ --namespace=${K8S_NAMESPACE}"
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                script {
                    echo "Running integration tests against ${params.DEPLOY_ENV}..."
                    // sh 'mvn verify -Pintegration-tests'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Deployment to ${params.DEPLOY_ENV} Successful!"
        }
        failure {
            echo "Deployment to ${params.DEPLOY_ENV} Failed!"
        }
    }
}
