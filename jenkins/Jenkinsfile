pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = "01sachinc"
        APP_NAME = "genops-ai"
        BACKEND_IMAGE = "${DOCKER_HUB_USER}/${APP_NAME}-backend"
        FRONTEND_IMAGE = "${DOCKER_HUB_USER}/${APP_NAME}-frontend"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            parallel {
                stage('Backend Build') {
                    steps {
                        dir('backend') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
                stage('Frontend Build') {
                    steps {
                        dir('frontend') {
                            sh 'npm install'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('', 'docker-hub-credentials') {
                        def backend = docker.build("${BACKEND_IMAGE}:${BUILD_NUMBER}", "./backend")
                        backend.push()
                        backend.push('latest')

                        def frontend = docker.build("${FRONTEND_IMAGE}:${BUILD_NUMBER}", "./frontend")
                        frontend.push()
                        frontend.push('latest')
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                dir('k8s') {
                    sh 'kubectl apply -f namespace.yaml'
                    sh 'kubectl apply -f config/'
                    sh 'kubectl apply -f postgres/'
                    sh 'kubectl apply -f redis/'
                    sh 'kubectl apply -f backend/'
                    sh 'kubectl apply -f frontend/'
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    sh 'sleep 30'
                    sh 'curl -f http://genops.api.local/health'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Deployment Successful!'
        }
        failure {
            echo 'Deployment Failed!'
        }
    }
}
